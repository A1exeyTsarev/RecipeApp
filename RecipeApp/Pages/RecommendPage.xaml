<UserControl x:Class="RecipeApp.Pages.RecommendPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="🎯 Что приготовить?" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <Button Grid.Row="1" 
                x:Name="BtnPickRandom" 
                Click="BtnPickRandom_Click"
                Content="🎲 Подобрать рецепт" 
                Width="200" 
                Height="40"
                Background="#F39C12" 
                Foreground="White" 
                FontWeight="Bold" 
                FontSize="16"
                Cursor="Hand" 
                HorizontalAlignment="Left" 
                Margin="0,0,0,15"/>

        <ListBox x:Name="ListRecommendations" 
                 Grid.Row="2" 
                 FontSize="14"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" 
                            Padding="12" 
                            Margin="0,6" 
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="{Binding Name}" 
                                       FontSize="18" 
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Row="1" 
                                       Text="{Binding IngredientsList}" 
                                       Foreground="#666" 
                                       Margin="0,5,0,5" 
                                       TextWrapping="Wrap"/>

                            <!-- Прогресс-бар -->
                            <Grid Grid.Row="2" Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Height="24" 
                                        Background="#ECF0F1" 
                                        CornerRadius="4"
                                        Margin="0,0,10,0">

                                    <Border Width="{Binding PercentageWidth}" 
                                            Background="{Binding ProgressColor}" 
                                            CornerRadius="4"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding PercentageText}" 
                                                   Foreground="White" 
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="5,0"/>
                                    </Border>
                                </Border>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding PercentageText}" 
                                           FontWeight="Bold" 
                                           VerticalAlignment="Center"
                                           Width="45"
                                           TextAlignment="Right"/>
                            </Grid>

                            <TextBlock Grid.Row="3" 
                                       Text="{Binding FullStatus}" 
                                       Foreground="{Binding StatusColor}" 
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>