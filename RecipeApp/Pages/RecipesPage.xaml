<UserControl x:Class="RecipeApp.Pages.RecipesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="📖 Мои рецепты" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <Button Grid.Row="1" 
                x:Name="BtnAddRecipe" 
                Click="BtnAddRecipe_Click"
                Content="➕ Добавить рецепт" 
                Width="180" 
                Height="35"
                Background="#2980B9" 
                Foreground="White" 
                FontWeight="Bold"
                Cursor="Hand" 
                HorizontalAlignment="Left" 
                Margin="0,0,0,10"/>

        <ListBox x:Name="ListRecipes" 
                 Grid.Row="2" 
                 FontSize="14"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" 
                            Padding="12" 
                            Margin="0,6" 
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                                       Text="{Binding Name}" 
                                       FontSize="18" 
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" 
                                       Text="{Binding IngredientsList}" 
                                       Foreground="#666" 
                                       Margin="0,5,0,5" 
                                       TextWrapping="Wrap"/>

                            <Border Grid.Row="2" Grid.Column="0" 
                                    CornerRadius="4" 
                                    Padding="8,3"
                                    Background="{Binding StatusColor}" 
                                    Margin="0,5,10,0">
                                <TextBlock Text="{Binding StatusText}" 
                                           FontWeight="Bold" 
                                           Foreground="White"
                                           FontSize="13"/>
                            </Border>

                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding MissingText}" 
                                       Foreground="#E74C3C" 
                                       FontSize="12" 
                                       Margin="0,5,0,0" 
                                       Visibility="{Binding HasMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button Grid.Row="0" Grid.Column="1" 
                                    Content="✕" 
                                    Width="28" 
                                    Height="28"
                                    Background="#E74C3C" 
                                    Foreground="White" 
                                    FontWeight="Bold"
                                    Click="DeleteRecipe_Click" 
                                    Tag="{Binding}"
                                    Cursor="Hand" 
                                    Margin="0,0,0,5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>