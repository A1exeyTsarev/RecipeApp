<Window x:Class="RecipeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:RecipeApp.Pages"
        Title="🍳 Кулинарный помощник"
        Height="650" Width="480"
        MinHeight="550" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Контейнер для страниц -->
        <Frame x:Name="MainFrame" Grid.Row="0" NavigationUIVisibility="Hidden"/>

        <!-- Нижняя навигация -->
        <Border Grid.Row="1" Background="#2C3E50">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">

                <Button x:Name="BtnProducts" 
                        Click="BtnProducts_Click"
                        Content="🧺 Продукты" 
                        Margin="5,0" 
                        Padding="12,8"
                        Background="#2C3E50" 
                        Foreground="White" 
                        FontSize="14" 
                        FontWeight="SemiBold"
                        BorderThickness="0" 
                        Cursor="Hand"/>

                <Button x:Name="BtnRecipes" 
                        Click="BtnRecipes_Click"
                        Content="📖 Рецепты" 
                        Margin="5,0" 
                        Padding="12,8"
                        Background="#2C3E50" 
                        Foreground="White" 
                        FontSize="14" 
                        FontWeight="SemiBold"
                        BorderThickness="0" 
                        Cursor="Hand"/>

                <Button x:Name="BtnRecommend" 
                        Click="BtnRecommend_Click"
                        Content="🎯 Подобрать" 
                        Margin="5,0" 
                        Padding="12,8"
                        Background="#2C3E50" 
                        Foreground="White" 
                        FontSize="14" 
                        FontWeight="SemiBold"
                        BorderThickness="0" 
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>